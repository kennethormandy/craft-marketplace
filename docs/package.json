{
  "name": "docs",
  "homepage": "https://craft-marketplace.kennethormandy.com",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build:api": "ddev php phpDocumentor.phar --directory=./plugins/craft-marketplace/src --target=./plugins/craft-marketplace/docs/docs/api --template=vendor/saggre/phpdocumentor-markdown/themes/markdown --visibility=public --defaultpackagename=Marketplace --title=Marketplace",
    "build:docs": "docusaurus build",
    "build": "npm run build:api; npm run build:docs",
    "swizzle": "docusaurus swizzle",
    "predeploy": "npm run build",
    "deploy": "surge ./build https://craft-marketplace.kennethormandy.com",
    "deploy:ci": "surge ./build https://craft-marketplace.kennethormandy.com",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.4.0",
    "@docusaurus/preset-classic": "^3.4.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "docusaurus-plugin-fathom": "^1.2.0",
    "docusaurus-theme-kennethormandy": "^1.0.0-beta.2",
    "dotenv": "^16.4.5",
    "raw-loader": "^4.0.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "surge": "^0.24.6"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.4.0",
    "@docusaurus/types": "3.4.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
